<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <RollForward>LatestMajor</RollForward>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpenPixel</AssemblyName>
    <RootNamespace>OpenPixel</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CA1416;WFO1000</NoWarn>
    <!-- The brand mark on the taskbar, window and Explorer icon. Without this the
         app inherits the generic .NET icon, which shows as a blank white square. -->
    <ApplicationIcon>assets\brand\OpenPixel.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="csharp\**\*.cs" />
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <!-- Inter ships inside the assembly so the UI font never depends on the PC. -->
    <EmbeddedResource Include="assets\island\*.png">
      <LogicalName>OpenPixel.Island.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\brand\OpenPixel.ico">
      <LogicalName>OpenPixel.Brand.OpenPixel.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\fonts\*.ttf">
      <LogicalName>OpenPixel.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\fonts\*.otf">
      <LogicalName>OpenPixel.Fonts.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="SkiaSharp" Version="*" />
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <!-- Keep the runnable OpenPixel.exe in the repository root identical to every
       Release build (apphost + its runtime files must sit next to the exe).
       A running OpenPixel holds these files open, so the build closes it and
       retries: after every Release build the root copies are the new ones. -->
  <Target Name="RefreshRootExecutable" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <RootAppDir>$(MSBuildProjectDirectory)\</RootAppDir>
    </PropertyGroup>
    <ItemGroup>
      <RootAppFiles Include="$(TargetDir)OpenPixel.exe" />
      <RootAppFiles Include="$(TargetDir)OpenPixel.dll" />
      <RootAppFiles Include="$(TargetDir)OpenPixel.deps.json" />
      <RootAppFiles Include="$(TargetDir)OpenPixel.runtimeconfig.json" />
      <RootAppFilesAtRoot Include="@(RootAppFiles->'$(RootAppDir)%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- Harmless attempt first: works when nothing is running. -->
    <Copy SourceFiles="@(RootAppFiles)" DestinationFolder="$(MSBuildProjectDirectory)" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" Retries="0" />

    <PropertyGroup>
      <_RootAppFilesExist>false</_RootAppFilesExist>
      <_RootAppFilesExist Condition="Exists('$(RootAppDir)OpenPixel.exe') and Exists('$(RootAppDir)OpenPixel.dll') and Exists('$(RootAppDir)OpenPixel.deps.json') and Exists('$(RootAppDir)OpenPixel.runtimeconfig.json')">true</_RootAppFilesExist>
    </PropertyGroup>

    <!-- Compare every file, not just the apphost: OpenPixel.exe is generic and
         can be byte-identical while OpenPixel.dll still holds old code. -->
    <GetFileHash Files="@(RootAppFiles)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_FreshAppHashes" />
    </GetFileHash>
    <GetFileHash Files="@(RootAppFilesAtRoot)" Algorithm="SHA256" Condition="'$(_RootAppFilesExist)' == 'true'">
      <Output TaskParameter="Items" ItemName="_RootAppHashes" />
    </GetFileHash>

    <PropertyGroup>
      <_RootAppNeedsRefresh Condition="'$(_RootAppFilesExist)' != 'true' or '@(_FreshAppHashes->'%(Filename)%(Extension)=%(FileHash)')' != '@(_RootAppHashes->'%(Filename)%(Extension)=%(FileHash)')'">true</_RootAppNeedsRefresh>
    </PropertyGroup>

    <Message Condition="'$(_RootAppNeedsRefresh)' == 'true'" Importance="high" Text="Replacing root OpenPixel.exe with the new build." />

    <!-- Stale copies mean the app is running: close it so the files can be written. -->
    <Exec Condition="'$(_RootAppNeedsRefresh)' == 'true'" Command="taskkill /F /IM OpenPixel.exe" IgnoreExitCode="true" ContinueOnError="WarnAndContinue" StandardOutputImportance="low" StandardErrorImportance="low" />

    <!-- Retries cover the moment while a terminated app releases its handles. -->
    <Copy Condition="'$(_RootAppNeedsRefresh)' == 'true'" SourceFiles="@(RootAppFiles)" DestinationFolder="$(MSBuildProjectDirectory)" Retries="10" RetryDelayMilliseconds="300" />

    <GetFileHash Files="@(RootAppFilesAtRoot)" Algorithm="SHA256" Condition="Exists('$(RootAppDir)OpenPixel.dll')">
      <Output TaskParameter="Items" ItemName="_RootAppHashesAfter" />
    </GetFileHash>
    <Error Condition="'@(_FreshAppHashes->'%(Filename)%(Extension)=%(FileHash)')' != '@(_RootAppHashesAfter->'%(Filename)%(Extension)=%(FileHash)')'" Text="The root OpenPixel.exe/dll could not be replaced with the new build (still locked by another process)." />

    <!-- The embedded web view, WinRT projections, and System.Management need
         their managed assemblies and native loaders (under runtimes/<rid>/native)
         next to the root OpenPixel.exe so it stays runnable standalone. -->
    <ItemGroup>
      <RootRuntimeDlls Include="$(TargetDir)*.dll" Exclude="$(TargetDir)OpenPixel.dll" />
      <RootWebNative Include="$(TargetDir)runtimes\**\*.*" />
      <RootRuntimeDllTarget Include="@(RootRuntimeDlls->'$(RootAppDir)%(Filename)%(Extension)')" />
      <RootWebNativeTarget Include="@(RootWebNative->'$(RootAppDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(RootRuntimeDlls)" DestinationFiles="@(RootRuntimeDllTarget)" SkipUnchangedFiles="true" Retries="5" RetryDelayMilliseconds="200" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="@(RootWebNative)" DestinationFiles="@(RootWebNativeTarget)" SkipUnchangedFiles="true" Retries="5" RetryDelayMilliseconds="200" ContinueOnError="WarnAndContinue" />
    <!-- Remove stale self-contained host DLLs from the repo root so the framework-dependent
         OpenPixel.exe always resolves the installed .NET Desktop Runtime instead of failing
         with a false ".NET Desktop Runtime required" prompt. -->
    <Delete Files="$(RootAppDir)hostfxr.dll;$(RootAppDir)hostpolicy.dll;$(RootAppDir)coreclr.dll" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
